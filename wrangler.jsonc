{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "obrasflow",
  "compatibility_date": "2026-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/index.mjs",
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "erpobras"
    }
  ],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  }
}
